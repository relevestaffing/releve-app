# Copy this file to .env.local and fill in the two values from Supabase.
# Without them the app runs in DEMO MODE: it works, but nothing is saved.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The address the app is served from — every link in every email is built
# from this. Locally http://localhost:3000; in Netlify https://app.relevestaffing.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Zoom (optional) -------------------------------------------------
# Server-to-Server OAuth app. Without these, interviews still book and
# the meeting link is simply left blank for someone to paste in.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Google Calendar (optional) --------------------------------------
# The same OAuth client you set up for Google sign-in. Needed only if you
# want people to be able to sync their calendar's free/busy times.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Console calendar (optional) --------------------------------------
# A different thing from the OAuth client above: this is a Google Cloud
# service account with domain-wide delegation, so /console/calendar can read
# hello@relevestaffing.com directly and show discovery calls and interviews
# without anyone connecting an account. client_email and private_key come
# from the service account's JSON key; keep the key's \n newlines literal.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
# Defaults to hello@relevestaffing.com if unset — the calendar read, and who
# the service account impersonates.
GOOGLE_CALENDAR_ID=hello@relevestaffing.com

# ---- outbound email (Google Workspace SMTP) ----
# Create a mailbox in Workspace, turn on 2-step verification on it, then
# generate an app password. Google stopped accepting plain passwords in 2025.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=team@relevestaffing.com
SMTP_PASS=the-16-character-app-password
SMTP_FROM=Relève <team@relevestaffing.com>

# ---- the scheduled runs (Friday check-in nudge, monthly pulse, run the month) ----
# Three Netlify scheduled functions in netlify/functions call the app's own
# /api/cron/* routes with this shared secret. REQUIRED in Netlify or nothing
# scheduled ever fires. Make one with: openssl rand -hex 24
CRON_SECRET=
# Server-side only. NEVER expose this or put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ---- database backups (scripts/backup.sh) ----
# Supabase > Project Settings > Database > Connection string > URI,
# with [YOUR-PASSWORD] replaced by your database password.
SUPABASE_DB_URL=

# ---- money (required for launch) ----
# Stripe: Developers > API keys (secret key) and Developers > Webhooks (signing secret
# for the endpoint https://app.relevestaffing.com/api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signs the pay-by-link URLs in the deposit and invoice emails. Any long random
# string; make one with: openssl rand -hex 32
DEPOSIT_LINK_SECRET=

# ---- DocuSign (optional; the talent agreement is sent by hand until these exist) ----
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_TALENT_AGREEMENT_TEMPLATE_ID=
DOCUSIGN_CONNECT_KEY=
# DOCUSIGN_ENV=production   # leave unset to use the developer sandbox

# ---- preview / walkthrough builds only ----
# Demo mode serves a fake account chosen by an unsigned cookie, including an
# ADMIN one. It used to switch itself on whenever the two NEXT_PUBLIC_SUPABASE_*
# variables were absent, which meant a production build that ran without them
# would have served full admin to anyone who set releve_demo_role=admin — and
# because NEXT_PUBLIC_* is inlined at BUILD time, the Netlify dashboard would
# still have listed the variables as set.
#
# It now requires this explicit opt-in as well. Set it ONLY on a preview deploy
# that is meant to be a walkthrough. Never on app.relevestaffing.com.
# NEXT_PUBLIC_DEMO_MODE=1
